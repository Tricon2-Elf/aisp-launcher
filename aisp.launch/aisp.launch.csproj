<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>aisp.launch</AssemblyName>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">dev</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DefaultWebsiteUrl Condition="'$(DefaultWebsiteUrl)' == ''">https://aisp.moe</DefaultWebsiteUrl>
    <DefaultGitHubRepo Condition="'$(DefaultGitHubRepo)' == ''">Tricon2-Elf/aisp-launcher</DefaultGitHubRepo>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DefaultWebsiteUrl</_Parameter1>
      <_Parameter2>$(DefaultWebsiteUrl)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DefaultGitHubRepo</_Parameter1>
      <_Parameter2>$(DefaultGitHubRepo)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Used when publishing with -p:PublishProfile=win-x86 -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <!-- SkiaSharp/HarfBuzzSharp ship native .pdb files (~100 MB) as loose sidecar files -->
  <Target
    Name="RemoveNativePdbsFromPublish"
    AfterTargets="ComputeFilesToPublish"
    BeforeTargets="CopyFilesToPublishDirectory"
    Condition="'$(PublishSingleFile)' == 'true'"
  >
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.pdb'"
      />
    </ItemGroup>
  </Target>

  <Target
    Name="DeleteNativePdbsFromPublishDir"
    AfterTargets="CopyFilesToPublishDirectory"
    Condition="'$(PublishSingleFile)' == 'true'"
  >
    <Delete Files="$(PublishDir)*.pdb" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <!-- Always reference for compile/IDE; WithDeveloperTools is only called under #if DEBUG. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Bundled into the launcher so Electron can be seeded after download (works with single-file publish). -->
  <ItemGroup>
    <EmbeddedResource Include="..\aisp.electron\app\main.js" LogicalName="aisp.electron.app.main.js" />
    <EmbeddedResource Include="..\aisp.electron\app\package.json" LogicalName="aisp.electron.app.package.json" />
    <EmbeddedResource Include="..\aisp.hook\dgVoodoo.conf" LogicalName="aisp.hook.dgVoodoo.conf" />
    <EmbeddedResource Include="..\environments.json" LogicalName="aisp.launch.environments.json" />
  </ItemGroup>
</Project>
