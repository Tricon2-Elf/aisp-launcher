<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1024"
        d:DesignHeight="720"
        x:Class="aisp.launch.MainWindow"
        Title="aisp.launch"
        Width="1024"
        Height="720"
        MinWidth="640"
        MinHeight="480">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top"
                Padding="0,0,0,12"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                  ColumnSpacing="12">
                <ComboBox x:Name="EnvironmentComboBox"
                          Grid.Column="0"
                          MinWidth="140"
                          VerticalAlignment="Center"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Stable" />
                    <ComboBoxItem Content="Dev" />
                    <ComboBoxItem Content="Local" />
                </ComboBox>

                <Button x:Name="OptionsButton"
                        Grid.Column="2"
                        MinWidth="120"
                        Padding="16,8"
                        Content="Options">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel MinWidth="240" Spacing="8">
                                <CheckBox x:Name="EnhancementsCheckBox"
                                          Content="Use Enhancements" />
                                <CheckBox x:Name="ElectronHwAccelCheckBox"
                                          Content="Electron HW Acceleration" />
                                <CheckBox x:Name="UseDxvkCheckBox"
                                          Content="Use Vulkan (DXVK)" />
                                <CheckBox x:Name="UseDgVoodooCheckBox"
                                          Content="Use Modern DirectX (dgVoodoo2)" />
                                <CheckBox x:Name="CheckUpdatesOnStartupCheckBox"
                                          Content="Check for updates on startup" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button x:Name="CheckUpdatesButton"
                        Grid.Column="3"
                        MinWidth="120"
                        Padding="16,8"
                        Content="Check for updates"
                        Click="OnCheckUpdatesClick" />

                <Button x:Name="StartGameButton"
                        Grid.Column="4"
                        MinWidth="120"
                        Padding="16,8"
                        Content="Start Game"
                        Click="OnStartGameClick" />
            </Grid>
        </Border>

        <ContentControl x:Name="WebsiteHost" />
    </DockPanel>
</Window>
